{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Noted",
  "version": "0.2.1",
  "identifier": "com.noted.desktop",
  "build": {
    "beforeBuildCommand": "npm --prefix ../web run build -- --mode desktop --outDir ../desktop/dist --emptyOutDir",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "capabilities": [],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png"],
    "windows": {
      "nsis": { "installMode": "currentUser", "displayLanguageSelector": false },
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true }
    }
  }
}
